**/.claude/settings.local.json
~/DevCloud/.gitignore_global
node_modules
*.mp4
*.mp3
*.zip
*.aab
.lastagent

# --- secrets: never commit (auto-commit checkpoint hook respects these for untracked files) ---
.env
.env.*
!.env.example
.env.op
shell_snapshots/
*.shell_snapshot
# Anchored to repo root on purpose: unanchored `commands/`/`skills/` stripped
# src/commands/** out of the published npm tarball and would strip template
# content (PJAN-2). Agent-tool dirs are listed explicitly instead.
#
# `/skills/` is deliberately NOT ignored: it holds skill SOURCE (9 skills, ~57
# files) that the rest of the tree only symlinks to --
# skillex/all-skills/agent-fleet-operations -> 33GOD/skills/... -> here. While it
# was ignored, that content was tracked by no repo at all and existed only on one
# disk. The npm tarball is governed by package.json `files` (an explicit
# allowlist) plus .npmignore, so .gitignore never affected packaging.
# The GENERATED projections below stay ignored; only the source is tracked.
.codegraph/
/commands/
/.agents/
/.opencode/
.claude/skills/

auth.json
/review.md
/sessions/

# --- generated plugin cache / staging ---
plugins/cache/
plugins/.remote-plugin-install-staging/


# Codex / agent runtime artifacts — never commit (auto-checkpoints swept these in)
tmp/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Secrets — .env is materialized by `op inject -i .env.op > .env` on mise enter.
# NEVER commit it. .env.op holds only 1Password references or safe literals and IS committed.
.env
.env.*
!.env.op
_bmad/config.user.yaml
.bmad-loop/runs/
.bmad-loop/cache/
.worktrees/

# Host-local agent caches and memory projections. These are mutable runtime
# state, never source dependencies or publishable project content (PJAN-41).
/.tmp/
/memories/

# Momo orchestration locks. A running orchestrator rewrites these (pid,
# heartbeat, ttl), so they can never be committed clean. `.momo/config.json`
# — the per-repo lane map — is real config and stays tracked.
.momo/*.lock
.momo/*.flock

# PJAN-75 test bundle (created and removed by tests/pjan-75-regressions.mjs)
.pjan-75-cli.mjs

# Suite scratch trees. Each is removed on a passing run; a failing run leaves
# one behind, and a red suite should not also dirty the worktree.
.pjan-67-trusted-lifecycle-*/
.pjan-77-test-build-*/

# Codex CLI runtime droppings swept in by early auto-checkpoint commits
# (config/state written when a Codex session ran with the repo root as cwd).
# Runtime state, never source.
/config.toml
/history.jsonl
/installation_id
/models_cache.json
/.personality_migration
/cache/
/sessions/
/run.log

# BMAD projections for CLIs outside the supported six (.agent = antigravity,
# .cursor, .cline, ...). Generated output, never tracked: with core.symlinks
# once set to false these checked out as plain text files holding a path, which
# is what made bmad.cli-roots report ".agent: ambiguous/user-owned" forever.
/.agent/

# Generated CLI configurations are durable project state...
!.claude/
!.claude/**
!.codex/
!.codex/**
!.gemini/
!.gemini/**
!.copilot/
!.copilot/**
!.opencode/
!.opencode/**
!.kimi-code/
!.kimi-code/**
# ...but their skill projections are regenerated by `bmad-method install` and
# `mise run skills:sync`, so they stay out of the tree.
/.agents/skills/
.claude/skills/
.codex/skills/
.gemini/skills/
.copilot/skills/
.opencode/skills/
.kimi-code/skills/

# Generated CLI configurations are durable project state...
!.claude/
!.claude/**
!.codex/
!.codex/**
!.gemini/
!.gemini/**
!.copilot/
!.copilot/**
!.opencode/
!.opencode/**
!.kimi-code/
!.kimi-code/**
# ...but their skill projections are regenerated by `bmad-method install` and
# `mise run skills:sync`, so they stay out of the tree. No trailing slash:
# some CLIs get a real directory here and some get a symlink.
/.agents/skills
.claude/skills
.codex/skills
.gemini/skills
.copilot/skills
.opencode/skills
.kimi-code/skills
